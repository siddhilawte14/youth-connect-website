# API base URL — points to the backend server
# In development the Vite proxy forwards /api requests to this address automatically.
# Set this only if you are deploying the frontend separately from the backend.
VITE_API_BASE_URL=http://localhost:5000

# Gemini AI API key (optional — only required if AI features are enabled)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
